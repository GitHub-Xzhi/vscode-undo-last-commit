{
  "name": "undo-last-commit",
  "displayName": "撤销上次提交",
  "description": "在源代码管理视图添加「撤销上次提交」按钮，点击后执行 git reset --soft HEAD~1，改动保留在暂存区。",
  "version": "0.0.1",
  "publisher": "xzhi",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "undoLastCommit.undo",
        "title": "撤销上次提交",
        "icon": "$(arrow-left)"
      }
    ],
    "menus": {
      "scm/sourceControl/title": [
        {
          "command": "undoLastCommit.undo",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ],
      "scm/title": [
        {
          "command": "undoLastCommit.undo",
          "when": "scmProvider == git",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^18.19.0",
    "@types/vscode": "^1.74.0",
    "typescript": "^5.4.0"
  }
}
